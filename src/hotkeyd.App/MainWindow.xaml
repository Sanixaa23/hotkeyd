<Window x:Class="Hotkeyd.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Hotkeyd.App"
        Style="{StaticResource AppWindow}"
        Title="hotkeyd" Height="640" Width="860"
        MinHeight="460" MinWidth="680"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: identity on the left, the global controls on the right. -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="hotkeyd" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted.Text}"
                           Text="Genel kısayollar — bir tuş birleşimine program bağla" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                    <CheckBox Content="Girişte başlat" Foreground="{StaticResource MutedForeground}"
                              IsChecked="{Binding StartupOn}" />
                </StackPanel>
                <TextBlock Text="Tümü" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{StaticResource MutedForeground}" />
                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MasterOn}"
                              VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,20,0,12">
            <Button Content="+  Kısayol ekle" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left" Command="{Binding AddCommand}" />
            <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedForeground}" />
        </Grid>

        <!-- The list of bindings -->
        <Border Grid.Row="2" Background="{StaticResource Card}"
                CornerRadius="{StaticResource CardRadius}"
                BorderBrush="{StaticResource Border}" BorderThickness="1">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Henüz kısayol yok" FontSize="16"
                               HorizontalAlignment="Center" Foreground="{StaticResource Foreground}" />
                    <TextBlock Text="&quot;Kısayol ekle&quot; ile başla" Margin="0,6,0,0"
                               HorizontalAlignment="Center" Foreground="{StaticResource MutedForeground}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:BindingRowVM}">
                                <Border Background="{StaticResource Muted}" CornerRadius="8"
                                        Margin="6,5" Padding="14,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ToggleButton Grid.Column="0" Style="{StaticResource Switch}"
                                                      VerticalAlignment="Center" Margin="0,0,16,0"
                                                      IsChecked="{Binding Enabled}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Background="{StaticResource Background}" CornerRadius="5"
                                                    Padding="7,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding HotkeyText}" FontFamily="Consolas"
                                                           FontSize="12" Foreground="{StaticResource Foreground}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                            <TextBlock Text="{Binding ActionDescription}"
                                                       Foreground="{StaticResource MutedForeground}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{StaticResource Warn}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="10,0,8,0">
                                            <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedForeground}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Düzenle" Style="{StaticResource GhostButton}"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Sil" Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,12,0,0" FontSize="12"
                   Foreground="{StaticResource MutedForeground}"
                   Text="hotkeyd yalnızca bağladığın tuş birleşimlerini işletim sisteminden dinler; başka hiçbir tuşu görmez veya kaydetmez." />
    </Grid>
</Window>
