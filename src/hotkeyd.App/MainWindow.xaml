<Window x:Class="Hotkeyd.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Hotkeyd.App"
        Style="{StaticResource AppWindow}"
        Title="hotkeyd" Height="660" Width="900"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen">

    <!-- The single frost layer over the acrylic backdrop. -->
    <Border Background="{StaticResource Frost}">
        <Grid Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="hotkeyd" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Muted.Text}" Margin="0,2,0,0"
                               Text="Genel kısayollar — bir tuş birleşimine iş bağla" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox Content="Girişte başlat" Style="{StaticResource SoftCheck}"
                              VerticalAlignment="Center" Margin="0,0,24,0"
                              IsChecked="{Binding StartupOn}" />
                    <TextBlock Text="Tümü" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{StaticResource Ink2}" />
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MasterOn}"
                                  VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="0,22,0,14">
                <Button Content="+  Kısayol ekle" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Command="{Binding AddCommand}" />
                <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontWeight="Medium" Foreground="{StaticResource Ink2}" />
            </Grid>

            <!-- The one opaque surface: the list panel. -->
            <Border Grid.Row="2" Background="{StaticResource Panel}"
                    CornerRadius="{StaticResource PanelRadius}"
                    BorderBrush="{StaticResource PanelEdge}" BorderThickness="1"
                    Effect="{StaticResource PanelShadow}">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Henüz kısayol yok" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Ink}" />
                        <TextBlock Text="&quot;Kısayol ekle&quot; ile başla" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" Foreground="{StaticResource Ink2}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,6">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:BindingRowVM}">
                                    <Border x:Name="rowBorder" Background="Transparent"
                                            BorderBrush="{StaticResource Hairline}"
                                            BorderThickness="0,0,0,1" Padding="16,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ToggleButton Grid.Column="0" Style="{StaticResource Switch}"
                                                          VerticalAlignment="Center" Margin="0,0,18,0"
                                                          IsChecked="{Binding Enabled}" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Ink}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Background="{StaticResource Chip}" CornerRadius="6"
                                                        Padding="8,3" Margin="0,5,0,0" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding HotkeyText}" FontSize="12"
                                                               FontFamily="Cascadia Code, Consolas"
                                                               Foreground="{StaticResource Ink}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0">
                                                <TextBlock Text="{Binding ActionDescription}"
                                                           Foreground="{StaticResource Ink2}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,3,0,0"
                                                           Foreground="{StaticResource Ink2}" TextWrapping="Wrap"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="10,0,10,0">
                                                <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"
                                                           FontWeight="Medium" Foreground="{StaticResource Ink2}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Düzenle" Style="{StaticResource GhostButton}"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Sil" Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="rowBorder" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="rowBorder" Property="Background"
                                                    Value="{StaticResource RowHover}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Margin="4,14,0,0" FontSize="12"
                       Foreground="{StaticResource Ink2}"
                       Text="hotkeyd yalnızca bağladığın tuş birleşimlerini işletim sisteminden dinler; başka hiçbir tuşu görmez veya kaydetmez." />
        </Grid>
    </Border>
</Window>
