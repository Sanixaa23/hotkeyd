<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--
        Dark Swiss / minimalist palette, from the design pass: a navy-grey
        corporate base with a single green accent used only for the "active"
        signal, nothing decorative. Colours are defined once here and every
        screen refers to them, so the look cannot drift between windows.
    -->
    <Color x:Key="BackgroundColor">#0F172A</Color>
    <Color x:Key="CardColor">#192134</Color>
    <Color x:Key="MutedColor">#10192E</Color>
    <Color x:Key="PrimaryColor">#1E3A5F</Color>
    <Color x:Key="AccentColor">#22C55E</Color>
    <Color x:Key="DestructiveColor">#DC2626</Color>
    <Color x:Key="WarnColor">#F59E0B</Color>

    <SolidColorBrush x:Key="Background" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Primary" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Destructive" Color="{StaticResource DestructiveColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedForeground" Color="#94A3B8" />
    <SolidColorBrush x:Key="Border" Color="#24314B" />

    <!-- Inter is the intended face; Segoe UI is the honest fallback when it is
         not installed, rather than pretending a web font ships with the app. -->
    <FontFamily x:Key="UiFont">Inter, Segoe UI</FontFamily>

    <sys:Double x:Key="RadiusSmall">6</sys:Double>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>

    <Style TargetType="{x:Type Window}" x:Key="AppWindow">
        <Setter Property="Background" Value="{StaticResource Background}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Foreground}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="TextBlock" x:Key="H1">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Foreground}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Muted.Text">
        <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
    </Style>

    <!-- Primary button. One accent-weighted action per surface; hover is a
         200ms lightening, per the motion guidance (subtle, not decorative). -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Foreground}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CardRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#2A4D7A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="GhostButton" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedForeground}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource CardRadius}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Muted}" />
                            <Setter Property="Foreground" Value="{StaticResource Foreground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="Field">
        <Setter Property="Background" Value="{StaticResource Muted}" />
        <Setter Property="Foreground" Value="{StaticResource Foreground}" />
        <Setter Property="CaretBrush" Value="{StaticResource Foreground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CardRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle styled as a switch: the master on/off and the per-row enable.
         The track turns accent-green only when on, which is the one place the
         accent is allowed, so "green" reads as "live" everywhere. -->
    <Style TargetType="ToggleButton" x:Key="Switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Background="{StaticResource Border}"
                            CornerRadius="13">
                        <Ellipse x:Name="knob" Width="20" Height="20" Fill="White"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
