<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--
        Apple-style light "vibrancy". The window itself is the one blurred,
        translucent layer (a real acrylic backdrop, applied in Backdrop.cs);
        everything above it is drawn here to read as material floating on that
        frost, following the design pass:

          One translucent layer, not many stacked. The window is frosted; the
          list panel on top is a MORE opaque white so text stays crisp. A
          second faint-on-faint glass would collapse legibility.

          Weight shows hierarchy: the big list panel carries a soft, deep
          shadow while small chips and buttons stay lighter. Colour is held
          back to Apple's own system hues, and the green accent is spent only
          on the one thing it means, a live hotkey. Text over the material is
          high-contrast, never flat grey on glass.
    -->

    <!-- Apple system colours (light). -->
    <Color x:Key="BlueColor">#007AFF</Color>
    <Color x:Key="GreenColor">#34C759</Color>
    <Color x:Key="RedColor">#FF3B30</Color>
    <Color x:Key="AmberColor">#FF9F0A</Color>
    <Color x:Key="GrayColor">#8E8E93</Color>

    <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />

    <!-- Text: near-black label, secondary grey. Contrast holds over the frost. -->
    <SolidColorBrush x:Key="Ink" Color="#1C1C1E" />
    <SolidColorBrush x:Key="Ink2" Color="#54545A" />

    <!-- The single frost tint laid over the acrylic so the window reads light
         even where the desktop behind it is dark, and still shows as frost if
         the OS has no acrylic to give. -->
    <SolidColorBrush x:Key="Frost" Color="#F4F7FB" Opacity="0.55" />

    <!-- The list panel: a near-solid white sheet, the one opaque surface. -->
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" Opacity="0.78" />
    <SolidColorBrush x:Key="PanelEdge" Color="#FFFFFF" Opacity="0.65" />
    <SolidColorBrush x:Key="Hairline" Color="#1C1C1E" Opacity="0.08" />
    <SolidColorBrush x:Key="RowHover" Color="#007AFF" Opacity="0.06" />
    <SolidColorBrush x:Key="Chip" Color="#1C1C1E" Opacity="0.05" />

    <!-- Segoe UI Variable is Windows 11's SF-adjacent system face: it ships the
         optical sizing and tracking Apple relies on. Plain Segoe UI is the
         fallback on older systems. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <CornerRadius x:Key="PanelRadius">16</CornerRadius>
    <CornerRadius x:Key="ControlRadius">10</CornerRadius>

    <Style TargetType="{x:Type Window}" x:Key="AppWindow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Headings take negative tracking as they grow; body sits near zero. -->
    <Style TargetType="TextBlock" x:Key="H1">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Muted.Text">
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    </Style>

    <!-- Primary action: Apple blue, soft, rounded. Press dips 1px of scale via
         opacity + a darker fill; hover lifts slightly. -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="{StaticResource Blue}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#0A84FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary: a light translucent chip, not an outline. -->
    <Style TargetType="Button" x:Key="GhostButton">
        <Setter Property="Background" Value="{StaticResource Chip}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="13,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1F000000" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="Field">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- iOS-style switch: grey track, white knob, fills Apple green when on. -->
    <Style TargetType="ToggleButton" x:Key="Switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" Background="#E2E3E7" CornerRadius="14">
                        <Grid>
                            <Ellipse x:Name="knob" Width="24" Height="24" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                      Opacity="0.25" Color="#000000" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Green}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Soft checkbox: a rounded square that fills Apple blue with a white
         tick when on, rather than the hard default Win32 box. -->
    <Style TargetType="CheckBox" x:Key="SoftCheck">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="21" Height="21" CornerRadius="7"
                                Background="#FFFFFF" BorderBrush="{StaticResource Hairline}"
                                BorderThickness="1.5" VerticalAlignment="Center">
                            <Path x:Name="tick" Stretch="Uniform" Width="12" Height="12"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Opacity="0"
                                  Data="M 2,6 L 5,9 L 10,2" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Blue}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Blue}" />
                            <Setter TargetName="tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Blue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A soft, deep shadow for the one big surface. -->
    <DropShadowEffect x:Key="PanelShadow" BlurRadius="34" ShadowDepth="6"
                      Direction="270" Opacity="0.14" Color="#20304A" />

</ResourceDictionary>
